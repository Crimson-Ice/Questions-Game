# Copier ce fichier en .env et choisir ses propres valeurs (.env n'est jamais commité).
POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=change-me

# Clé de signature des jetons JWT (au moins 32 caractères aléatoires).
JWT_SIGNING_KEY=change-me-with-at-least-32-random-characters

# Compte administrateur créé au premier démarrage (mot de passe : 12 caractères minimum).
ADMIN_EMAIL=admin@quiz.local
ADMIN_PASSWORD=change-me-please
